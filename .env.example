# ==========================================
# TERABOX-CLI CONFIGURATION
# ==========================================

# 1. TELEGRAM BOT CREDENTIALS (Wajib)
# Dapatkan API ID & Hash dari https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# Token bot dari @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 2. TARGET USER ID / OWNER (Wajib)
# Telegram User ID tujuan pengiriman file (bisa didapat via bot seperti @userinfobot)
TARGET_USER_ID=123456789
# Alternatif fallback jika TARGET_USER_ID kosong:
# OWNER_ID=123456789

# 3. TERABOX EXTRACTOR COOKIE (Opsional)
# Masukkan cookie 'ndus' dari akun terabox jika ingin download file besar / bypass limit
TERABOX_NDUS=
# TERABOX_COOKIE=
